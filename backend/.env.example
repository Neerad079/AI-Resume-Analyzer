# ==============================================================
# HireIQ Backend Environment Variables Template
# ==============================================================

# Server Port (Railway sets PORT automatically)
PORT=8080

# Database Configuration (For Railway MySQL, either use SPRING_DATASOURCE_URL or the MYSQL* variables)
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3308/hireiq?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
MYSQL_HOST=localhost
MYSQL_PORT=3308
MYSQL_DB=hireiq
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here

# JWT Security (Minimum 256 bits secret string)
JWT_SECRET=your_super_secret_jwt_key_at_least_256_bits_long

# AI Provider Configuration (nvidia, groq, gemini, or openai)
AI_PROVIDER=nvidia
AI_API_KEY=your_ai_api_key_here
AI_MODEL=nvidia/nemotron-3-super-120b-a12b
AI_BASE_URL=https://integrate.api.nvidia.com/v1

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Frontend URL (For OAuth2 redirect and CORS)
# In production, set this to your deployed frontend URL (e.g. FRONTEND_URL=https://your-hireiq-frontend.vercel.app)
FRONTEND_URL=
CORS_ORIGINS=https://your-hireiq-frontend.vercel.app,http://localhost:5173,http://localhost:3000

