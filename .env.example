# ==============================================
# HireIQ - Environment Variables Template
# ==============================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit the .env file!

# ---- Server Port (Railway sets PORT automatically) ----
PORT=8080

# ---- MySQL / Database ----
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3308/hireiq?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
MYSQL_ROOT_PASSWORD=your_mysql_root_password
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=hireiq
MYSQL_PORT=3308

# ---- JWT ----
JWT_SECRET=your-jwt-secret-key-at-least-256-bits-long

# ---- AI Provider ----
# Supported: nvidia, groq, gemini, openai
AI_API_KEY=your_ai_api_key_here
AI_PROVIDER=nvidia
AI_MODEL=meta/llama-3.3-70b-instruct
AI_BASE_URL=https://integrate.api.nvidia.com/v1

# ---- Google OAuth 2.0 ----
# Get these from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ---- Frontend & CORS Configuration ----
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost
VITE_API_URL=http://localhost:8080/api
